  "idf.toolsPathWin": "D:\\Software\\ESP-IDF_5.5.3\\Espressif",
  "idf.pythonInstallPath": "D:\\Software\\ESP-IDF_5.5.3\\Espressif\\tools\\idf-python\\3.11.2\\python.exe",
  "idf.flashType": "UART",
  "idf.port": "COM231",
